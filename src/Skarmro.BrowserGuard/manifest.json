{
  "manifest_version": 3,
  "name": "SKÄRMRO Browser Guard",
  "version": "0.1.0",
  "description": "SKÄRMRO child-safe Chrome browser guard prototype.",
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "policy.js",
        "rules.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ],
  "options_page": "options.html"
}
