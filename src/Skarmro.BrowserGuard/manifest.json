{
  "manifest_version": 3,
  "name": "SKÄRMRO Browser Guard",
  "version": "0.7.0",
  "description": "SKÄRMRO child-safe Chrome browser guard prototype.",
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "policy.js",
        "lexicon.js",
        "rules.js",
        "content.js"
      ],
      "run_at": "document_start",
      "css": [
        "content.css"
      ]
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "alarms"
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "SKÄRMRO Browser Guard",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
