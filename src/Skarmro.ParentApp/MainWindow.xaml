<Window x:Class="Skarmro.ParentApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SKÄRMRO Parent App"
        Width="1280" Height="820"
        MinWidth="1050" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0C1219" BorderBrush="#1D2834" BorderThickness="0,0,1,0">
            <DockPanel Margin="22">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                        <Border Width="44" Height="44" CornerRadius="14" Background="#EAF3FF">
                            <TextBlock Text="S" Foreground="#0B1118" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,2,0,0">
                            <TextBlock Text="SKÄRMRO" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="Parent App" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="OverviewNavButton" Content="Översikt" HorizontalContentAlignment="Left" Background="#182432" Foreground="White" Margin="0,0,0,8" Click="ShowOverview_Click"/>
                    <Button Content="Webbskydd" HorizontalContentAlignment="Left" Background="#101923" Foreground="#AFC0D2" Margin="0,0,0,8" IsEnabled="False"/>
                    <Button Content="Rutiner" HorizontalContentAlignment="Left" Background="#101923" Foreground="#AFC0D2" Margin="0,0,0,8" IsEnabled="False"/>
                    <Button x:Name="AppsNavButton" Content="Appar" HorizontalContentAlignment="Left" Background="#101923" Foreground="#AFC0D2" Margin="0,0,0,8" Click="ShowApps_Click"/>
                    <Button Content="Protection Health" HorizontalContentAlignment="Left" Background="#101923" Foreground="#AFC0D2" IsEnabled="False"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Border Background="#101923" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="12">
                        <StackPanel>
                            <TextBlock Text="●  SkarmroChild" Foreground="{StaticResource GoodBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="Windows-barnkonto" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="16,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Native preview · Morning Build" Foreground="#6F8194" FontSize="10" Margin="2,12,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#18222E" BorderThickness="0,0,0,1" Padding="32,24">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="SKÄRMRO · BOUNDARY, NOT SURVEILLANCE" Foreground="#84A0BD" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PageTitleText" Text="Översikt" FontSize="30" FontWeight="Bold" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="SaveNativePolicyButton" Content="Spara native-policy" HorizontalAlignment="Right" VerticalAlignment="Center" Click="SaveNativePolicy_Click" ToolTip="Sparar ändrade appregler via Guard Service"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="32">
                    <StackPanel x:Name="OverviewPanel">
                    <Border Background="#111B25" BorderBrush="#253342" BorderThickness="1" CornerRadius="22" Padding="30">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SKYDDET ÄR AKTIVT" Foreground="{StaticResource GoodBrush}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="En lugnare Windows-dator för barn." FontWeight="Bold" FontSize="34" Margin="0,8,0,8"/>
                                <TextBlock TextWrapping="Wrap" MaxWidth="760" Foreground="{StaticResource MutedBrush}" FontSize="14"
                                           Text="SKÄRMRO kombinerar automatiskt webbskydd, tydliga rutiner och Windows-regler utan att läsa privata meddelanden eller spela in skärmen."/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="150" Height="150" CornerRadius="75" BorderBrush="#385166" BorderThickness="1" Background="#12202B" HorizontalAlignment="Right">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="✓" FontSize="48" Foreground="{StaticResource GoodBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Skydd aktivt" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <UniformGrid Columns="4" Margin="0,16,0,16">
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,10,0">
                            <StackPanel><TextBlock Text="Auto Protect" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="På" FontSize="23" FontWeight="Bold" Margin="0,8,0,3"/><TextBlock Text="Automatisk filtrering" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,10,0">
                            <StackPanel><TextBlock Text="YouTube Shorts" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="Blockeras" FontSize="23" FontWeight="Bold" Margin="0,8,0,3"/><TextBlock Text="Döljs och stoppas" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,10,0">
                            <StackPanel><TextBlock Text="Aktiv rutin" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="ActiveRoutineText" Text="Ingen" FontSize="23" FontWeight="Bold" Margin="0,8,0,3"/><TextBlock Text="Normal skyddsnivå" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                            <StackPanel><TextBlock Text="Native Guard" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="Väntar" Foreground="{StaticResource WarnBrush}" FontSize="23" FontWeight="Bold" Margin="0,8,0,3"/><TextBlock Text="Signering krävs på WILMA" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="PROTECTION HEALTH" Foreground="#84A0BD" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Text="Skyddsstatus" FontSize="21" FontWeight="Bold" Margin="0,4,0,14"/>
                                <TextBlock Text="✓  Browser Guard aktiv" Margin="0,5"/>
                                <TextBlock Text="✓  Auto Protect aktiv" Margin="0,5"/>
                                <TextBlock Text="✓  Shorts-skydd aktivt" Margin="0,5"/>
                                <TextBlock x:Name="NativeGuardHealthText" Text="!  Native Guard kontrolleras..." Foreground="#F3C46B" Margin="0,5"/>
                                <TextBlock x:Name="NativePolicyHealthText" Text="!  Native policy kontrolleras..." Foreground="#F3C46B" Margin="0,5"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="SNABBKONTROLLER" Foreground="#84A0BD" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Text="Nu direkt" FontSize="21" FontWeight="Bold" Margin="0,4,0,14"/>
                                <WrapPanel>
                                    <Button Content="Pausa YouTube 30 min" ToolTip="Tillgänglig när snabbkontroller är aktiverade"/>
                                    <Button Content="Ge 15 min extra tid" ToolTip="Tillgänglig när snabbkontroller är aktiverade"/>
                                </WrapPanel>
                                <TextBlock Text="Tillgänglig när Native Guard är aktiv." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,0"/>
                                <TextBlock Text="Native app-kontroller kopplas till Guard Service via IPC i nästa signerade runtime." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    </StackPanel>

                    <StackPanel x:Name="AppsPanel" Visibility="Collapsed">
                        <Border Background="#111B25" BorderBrush="#253342" BorderThickness="1" CornerRadius="22" Padding="26" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="APPREGLER" Foreground="#84A0BD" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Text="Bestäm vilka program barnet får använda." FontWeight="Bold" FontSize="30" Margin="0,6,0,8"/>
                                <TextBlock Text="Blockerade appar stoppas av Guard Service för SkarmroChild. Tillåt-listan sparas i policyn och används som tydlig baseline utan att riskera att viktiga Windows-processer blockeras." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="TILLÅTNA APPAR" Foreground="#84A0BD" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="Tillåt-lista" FontSize="22" FontWeight="Bold" Margin="0,4,0,10"/>
                                    <ListBox x:Name="AllowedAppsList" MinHeight="260" Margin="0,0,0,12"/>
                                    <TextBlock Text="Skriv programnamn, t.ex. calc.exe" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/>
                                    <DockPanel>
                                        <TextBox x:Name="AllowedAppInput" MinWidth="220" Margin="0,0,8,0" ToolTip="Exempel: calc.exe"/>
                                        <Button Content="Lägg till" Click="AddAllowedApp_Click"/>
                                    </DockPanel>
                                    <Button Content="Ta bort vald" Margin="0,10,0,0" Click="RemoveAllowedApp_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="BLOCKERADE APPAR" Foreground="#84A0BD" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="Guard blockerar dessa" FontSize="22" FontWeight="Bold" Margin="0,4,0,10"/>
                                    <ListBox x:Name="BlockedAppsList" MinHeight="260" Margin="0,0,0,12"/>
                                    <TextBlock Text="Skriv programnamn, t.ex. notepad.exe" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/>
                                    <DockPanel>
                                        <TextBox x:Name="BlockedAppInput" MinWidth="220" Margin="0,0,8,0" ToolTip="Exempel: msedge.exe"/>
                                        <Button Content="Blockera" Click="AddBlockedApp_Click"/>
                                    </DockPanel>
                                    <Button Content="Ta bort vald" Margin="0,10,0,0" Click="RemoveBlockedApp_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="#101923" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock x:Name="AppsPolicyStatusText" Text="Läser aktuell policy..." FontWeight="SemiBold"/>
                                <TextBlock Text="Ändringarna börjar gälla när du klickar Spara native-policy. Guard Service läser policyfilen vid nya processstarter." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
