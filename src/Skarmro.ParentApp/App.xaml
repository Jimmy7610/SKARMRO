<Application x:Class="Skarmro.ParentApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#0A0F15"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#111821"/>
        <SolidColorBrush x:Key="Panel2Brush" Color="#151F2A"/>
        <SolidColorBrush x:Key="LineBrush" Color="#273443"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9FB0C3"/>
        <SolidColorBrush x:Key="GoodBrush" Color="#66D29C"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#0A0F15"/>
            <Setter Property="Background" Value="#EAF3FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Application.Resources>
</Application>
