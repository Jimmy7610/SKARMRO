<Window x:Class="Skarmro.JuniorLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SKÄRMRO Junior"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource Bg}"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="38,28,38,10">
            <StackPanel>
                <TextBlock Text="SKÄRMRO" FontSize="14" FontWeight="Bold" Foreground="#A9C8E8"/>
                <TextBlock Text="Hej! Vad vill du göra?" FontSize="38" FontWeight="Bold" Margin="0,6,0,0"/>
                <TextBlock Text="Välj en av dina godkända appar." FontSize="16" Foreground="#9FB0C3" Margin="0,7,0,0"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#132838" CornerRadius="16" Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="#66D29C" Margin="0,0,9,0"/>
                    <TextBlock x:Name="ProtectionStatusText" Text="Skydd aktivt" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="38,28">
                <WrapPanel x:Name="AppTilesPanel" ItemWidth="250" ItemHeight="190"/>
                <Border x:Name="EmptyStatePanel" Visibility="Collapsed" Background="#111B25" CornerRadius="18" Padding="28" MaxWidth="560" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="Inga appar är tillagda ännu" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="Be en vuxen lägga till appar i SKÄRMRO Parent App." Foreground="#9FB0C3" FontSize="14" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="38,10,38,28">
            <TextBlock Text="Tips: Be en vuxen om du behöver en app som inte finns här." Foreground="#8194A8" VerticalAlignment="Center"/>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="Förälder: Ctrl + Shift + F12" Foreground="#506275" FontSize="11"/>
        </Grid>
    </Grid>
</Window>
