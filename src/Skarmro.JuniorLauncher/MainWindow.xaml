<Window x:Class="Skarmro.JuniorLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SKÄRMRO Junior"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource Bg}"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="38,28,38,10">
            <StackPanel>
                <TextBlock Text="SKÄRMRO" FontSize="14" FontWeight="Bold" Foreground="#A9C8E8"/>
                <TextBlock Text="Hej! Vad vill du göra?" FontSize="38" FontWeight="Bold" Margin="0,6,0,0"/>
                <TextBlock Text="Välj en av dina godkända appar." FontSize="16" Foreground="#9FB0C3" Margin="0,7,0,0"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#132838" CornerRadius="16" Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="#66D29C" Margin="0,0,9,0"/>
                    <TextBlock Text="Skydd aktivt" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel Margin="38,28" ItemWidth="250" ItemHeight="190">
                <Button Tag="calc.exe" Click="Launch_Click" Margin="0,0,18,18" Background="#183247" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="＋" FontSize="54" HorizontalAlignment="Center"/>
                        <TextBlock Text="Miniräknare" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Button>
                <Button Tag="mspaint.exe" Click="Launch_Click" Margin="0,0,18,18" Background="#25364A" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="✎" FontSize="52" HorizontalAlignment="Center"/>
                        <TextBlock Text="Rita" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Button>
                <Button Tag="chrome.exe" Click="Launch_Click" Margin="0,0,18,18" Background="#243E37" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="◎" FontSize="52" HorizontalAlignment="Center"/>
                        <TextBlock Text="Internet" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock Text="SKÄRMRO Browser Guard" FontSize="11" Foreground="#B5C6D6" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="38,10,38,28">
            <TextBlock Text="Tips: Be en vuxen om du behöver en app som inte finns här." Foreground="#8194A8" VerticalAlignment="Center"/>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="Förälder: Ctrl + Shift + F12" Foreground="#506275" FontSize="11"/>
        </Grid>
    </Grid>
</Window>
